<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinForge.Pages.ReactorSettingsModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:WinForge.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

            <!-- header -->
            <controls:ModuleHeader x:Name="Header" Glyph="&#xE713;" />

            <Button x:Name="BackToReactorButton" MinHeight="44" Click="BackToReactor_Click" />

            <!-- Optional simulated emergency-diesel fallback for deliberately playful feature gates -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FeaturePowerTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="DieselFallbackToggle" Toggled="DieselFallback_Toggled" />
                    <TextBlock x:Name="FeaturePowerNote" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="FeatureDieselControls" Spacing="8" Visibility="Collapsed">
                        <ProgressBar
                            x:Name="FeatureDieselFuelProgress"
                            Height="8"
                            AutomationProperties.Name="Emergency diesel fuel level · 應急柴油發電機油量"
                            Maximum="60"
                            Minimum="0" />
                        <TextBlock x:Name="FeatureDieselFuelText" TextWrapping="Wrap" />
                        <ProgressBar
                            x:Name="FeatureDieselProgress"
                            Height="8"
                            AutomationProperties.Name="Emergency diesel start progress · 應急柴油發電機啟動進度"
                            Maximum="10"
                            Minimum="0" />
                        <TextBlock x:Name="FeatureDieselStateText" TextWrapping="Wrap" />
                        <Button
                            x:Name="FillFeatureDieselButton"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="FillFeatureDiesel_Click" />
                        <Button
                            x:Name="StartFeatureDieselButton"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="StartFeatureDiesel_Click" />
                        <Button
                            x:Name="StopFeatureDieselButton"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="StopFeatureDiesel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Keep PC awake -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="KeepAwakeToggle" Toggled="KeepAwake_Toggled" />
                    <TextBlock x:Name="KeepAwakeNote" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Windows-settings linkage -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="SysLinkToggle" Toggled="SysLink_Toggled" />
                    <TextBlock x:Name="SysLinkWarn" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ARM real shutdown on meltdown -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ArmTitle" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="ArmToggle" Toggled="Arm_Toggled" />
                    <TextBlock x:Name="ArmWarn" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
            </Border>

            <!-- Public status API -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ApiTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApiBlurb" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ApiNames" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="ApiToggle" Toggled="Api_Toggled" />
                    <TextBlock x:Name="ApiStateText" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Crash-safe autosave -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="AutosaveToggle" Toggled="Autosave_Toggled" />
                    <TextBlock x:Name="AutosaveNote" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Home Assistant mirror -->
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="HaTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="HaBlurb" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- shown when HA is not configured -->
                    <Border x:Name="HaNotConfigured" Visibility="Collapsed" CornerRadius="6" Padding="12"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="HaNotConfiguredText" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <Button x:Name="HaOpenModuleButton" Click="HaOpenModule_Click" />
                        </StackPanel>
                    </Border>

                    <!-- shown when HA IS configured -->
                    <StackPanel x:Name="HaConfigured" Spacing="10" Visibility="Collapsed">
                        <ToggleSwitch x:Name="HaMirrorToggle" Toggled="HaMirror_Toggled" />

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HaAlarmLabel" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HaAlarmSearchBox" TextChanged="HaSearch_TextChanged" />
                            <ListBox x:Name="HaAlarmLightsList" SelectionMode="Multiple" Height="170"
                                     SelectionChanged="HaAlarmLights_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HaGenLightsLabel" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HaGenLightsSearchBox" TextChanged="HaSearch_TextChanged" />
                            <ListBox x:Name="HaGenLightsList" SelectionMode="Multiple" Height="170"
                                     SelectionChanged="HaGenLights_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HaGenLabel" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HaGenSwitchesSearchBox" TextChanged="HaSearch_TextChanged" />
                            <ListBox x:Name="HaGenSwitchesList" SelectionMode="Multiple" Height="170"
                                     SelectionChanged="HaGenSwitches_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="HaRefreshButton" Click="HaRefresh_Click" />
                            <TextBlock x:Name="HaStatusText" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
