<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinForge.Pages.ReactorDependencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:WinForge.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="24,18,24,24"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="860"
            HorizontalAlignment="Left"
            Spacing="14">
            <controls:ModuleHeader x:Name="Header" Glyph="&#xEBC0;" />

            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="True" />

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="RequirementTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock x:Name="RequirementText" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReasonText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SnapshotText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                x:Name="DieselPanel"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DieselTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DieselDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="DieselFuelProgress"
                        Height="8"
                        AutomationProperties.Name="Emergency diesel fuel level · 應急柴油發電機油量"
                        Maximum="60"
                        Minimum="0" />
                    <TextBlock x:Name="DieselFuelText" TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="DieselProgress"
                        Height="8"
                        AutomationProperties.Name="Emergency diesel start progress · 應急柴油發電機啟動進度"
                        Maximum="10"
                        Minimum="0" />
                    <TextBlock x:Name="DieselStateText" TextWrapping="Wrap" />
                    <Button
                        x:Name="FillDieselButton"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        Click="FillDiesel_Click" />
                    <Button
                        x:Name="StartDieselButton"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        Click="StartDiesel_Click" />
                    <Button
                        x:Name="StopDieselButton"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        Click="StopDiesel_Click" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <Button
                    x:Name="EnableFallbackButton"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    Click="EnableFallback_Click" />
                <Button
                    x:Name="OpenReactorButton"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    Click="OpenReactor_Click" />
                <Button
                    x:Name="RetryButton"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    Click="Retry_Click" />
                <Button
                    x:Name="EnableApiButton"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    Click="EnableApi_Click" />
                <Button
                    x:Name="SettingsButton"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    Click="Settings_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
