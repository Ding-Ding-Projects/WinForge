<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinForge.Pages.RegexTesterModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:WinForge.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Spacing="14">
            <controls:ModuleHeader x:Name="Header" Glyph="&#xE773;" />
            <TextBlock x:Name="HeaderBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Pattern + options -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="EngineText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="PatternBox" TextChanged="Input_Changed" FontFamily="Consolas" AcceptsReturn="False" MaxLength="4096" />

                    <Expander x:Name="BuilderExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="0,8,0,0" Spacing="10">
                            <TextBlock x:Name="BuilderIntroText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox x:Name="BuilderKindBox" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="BuilderKind_Changed" />
                                <ComboBox x:Name="BuilderVariantBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
                                <TextBox x:Name="BuilderPrimaryBox" Grid.Row="1" Grid.Column="0" FontFamily="Consolas" MaxLength="4096" />
                                <TextBox x:Name="BuilderSecondaryBox" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" MaxLength="4096" />
                                <CheckBox x:Name="BuilderOptionCheck" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" />
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AddPieceButton" Click="AddPiece_Click" />
                                    <Button x:Name="ClearPatternButton" Click="ClearPattern_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BuilderStatusText" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <StackPanel x:Name="OptionsPanel" Spacing="6">
                        <CheckBox x:Name="IgnoreCaseChk" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="MultilineChk" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="SinglelineChk" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="IgnoreWsChk" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="ExplicitCaptureChk" Checked="Option_Changed" Unchecked="Option_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyPatternButton" Click="CopyPattern_Click" />
                        <Button x:Name="CopyMatchesButton" Click="CopyMatches_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Test input -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InputLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="InputBox" TextChanged="Input_Changed" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="140" MaxLength="1000000" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MatchCountText" FontWeight="SemiBold" />
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,0,0" Padding="10,8,10,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{Binding Groups}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding GroupsVisible}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Replacement -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ReplacementLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="ReplacementBox" TextChanged="Input_Changed" FontFamily="Consolas" AcceptsReturn="False" MaxLength="65536" />
                    <TextBlock x:Name="ResultLabel" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- Cheat sheet -->
            <Expander x:Name="CheatExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="CheatText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
