<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinForge.Pages.TotpModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:WinForge.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Spacing="14">
            <controls:ModuleHeader x:Name="Header" Glyph="&#xE72E;" />
            <TextBlock x:Name="HeaderBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Saved local authenticator entries. Metadata is local JSON; secrets stay in the Windows credential vault. -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="EntriesTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="EntriesBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <controls:SearchPatternBox x:Name="EntrySearchBox" AutomationName="Authenticator entry search" />
                    <TextBlock x:Name="EntryCountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyEntriesText" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.Name="Authenticator empty state" />
                    <StackPanel x:Name="EntriesPanel" Spacing="8" />
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <Button x:Name="ExportJsonButton" Click="ExportJson_Click" MinHeight="40" />
                        <Button x:Name="ExportCsvButton" Click="ExportCsv_Click" MinHeight="40" />
                    </StackPanel>
                    <TextBlock x:Name="ExportDisclosure" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Live code card -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="CodeLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CodeText" Text="— — —" FontFamily="Consolas" FontSize="40" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="72" Height="72">
                            <muxc:ProgressRing x:Name="CountRing" IsIndeterminate="False" Value="100" Maximum="100" Width="72" Height="72" />
                            <TextBlock x:Name="CountText" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                        </Grid>
                        <Button x:Name="CopyBtn" Click="Copy_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Configuration card -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SecretLabel" FontWeight="SemiBold" />
                        <PasswordBox x:Name="SecretBox" PasswordChanged="Config_Changed" MaxLength="512" PlaceholderText="Base32 secret (masked until you choose to register it)" FontFamily="Consolas" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IssuerBox" Grid.Column="0" />
                        <TextBox x:Name="AccountBox" Grid.Column="1" />
                    </Grid>
                    <TextBox x:Name="GroupBox" />
                    <Button x:Name="SaveMetadataButton" Click="SaveMetadata_Click" MinHeight="40" IsEnabled="False" />

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="UriLabel" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UriBox" Grid.Column="0" MaxLength="4096" PlaceholderText="otpauth://totp/Example?secret=JBSWY3DPEHPK3PXP&amp;issuer=Example" />
                            <Button x:Name="ImportBtn" Grid.Column="1" Click="Import_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <Button x:Name="PasteUriButton" Click="PasteUri_Click" HorizontalAlignment="Left" MinHeight="40" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DigitsLabel" />
                            <NumberBox x:Name="DigitsBox" Minimum="6.0" Maximum="8.0" SpinButtonPlacementMode="Inline" MinWidth="120" ValueChanged="Number_Changed" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="PeriodLabel" />
                            <NumberBox x:Name="PeriodBox" Minimum="1.0" Maximum="600.0" SpinButtonPlacementMode="Inline" MinWidth="120" ValueChanged="Number_Changed" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="AlgoLabel" />
                            <ComboBox x:Name="AlgoBox" MinWidth="140" SelectionChanged="Algo_Changed">
                                <ComboBoxItem Content="SHA1" />
                                <ComboBoxItem Content="SHA256" />
                                <ComboBoxItem Content="SHA512" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Local QR pairing card: the secret never leaves this process. -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="QrTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="QrBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="176" Height="176" Padding="8" Background="White" CornerRadius="8">
                            <Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="Local TOTP pairing QR code" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="QrStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="QrButton" Click="GenerateQr_Click" HorizontalAlignment="Left" />
                            <TextBox x:Name="ConfirmCodeBox" PlaceholderText="123456" MaxLength="10" FontFamily="Consolas" />
                            <Button x:Name="ConfirmPairingButton" Click="ConfirmPairing_Click" HorizontalAlignment="Left" IsEnabled="False" />
                            <Button x:Name="ClearPairingButton" Click="ClearPairing_Click" HorizontalAlignment="Left" MinHeight="40" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
