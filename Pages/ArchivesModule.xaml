<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinForge.Pages.ArchivesModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:WinForge.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" Spacing="14">

            <controls:ModuleHeader x:Name="Header" Glyph="&#xE7B8;" />
            <TextBlock x:Name="HeaderBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <InfoBar x:Name="EngineBar" IsClosable="False" IsOpen="False" />
            <!-- Rich install-progress host for the 7-Zip prerequisite (bar + live status + % + Cancel). -->
            <StackPanel x:Name="EngineInstallHost" />

            <!-- Selection -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="SelLabel" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ArcCap" Grid.Column="0" VerticalAlignment="Center" Width="70" />
                        <TextBox x:Name="ArchiveBox" Grid.Column="1" IsReadOnly="True" />
                        <Button x:Name="OpenArcBtn" Grid.Column="2" Click="OpenArchive_Click" />
                        <Button x:Name="NewArcBtn" Grid.Column="3" Click="NewArchive_Click" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SrcCap" Grid.Column="0" VerticalAlignment="Center" Width="70" />
                        <TextBox x:Name="SourceBox" Grid.Column="1" IsReadOnly="True" />
                        <Button x:Name="SrcFileBtn" Grid.Column="2" Click="SourceFile_Click" />
                        <Button x:Name="SrcFolderBtn" Grid.Column="3" Click="SourceFolder_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Create -->
            <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CreateLabel" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="FormatBox" Grid.Row="0" Grid.Column="0" MinWidth="110" SelectedIndex="0">
                            <ComboBoxItem Content="7z" Tag="7z" />
                            <ComboBoxItem Content="zip" Tag="zip" />
                            <ComboBoxItem Content="tar" Tag="tar" />
                            <ComboBoxItem Content="gzip" Tag="gzip" />
                            <ComboBoxItem Content="bzip2" Tag="bzip2" />
                            <ComboBoxItem Content="xz" Tag="xz" />
                        </ComboBox>
                        <ComboBox x:Name="LevelBox" Grid.Row="0" Grid.Column="1" MinWidth="150" SelectedIndex="2">
                            <ComboBoxItem Content="0 · Store · 唔壓縮" Tag="0" />
                            <ComboBoxItem Content="1 · Fast · 快" Tag="1" />
                            <ComboBoxItem Content="5 · Normal · 普通" Tag="5" />
                            <ComboBoxItem Content="9 · Ultra · 極限" Tag="9" />
                        </ComboBox>
                        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="0" />
                        <Button x:Name="CreateBtn" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="Create_Click" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="VolumeBox" Grid.Row="0" Grid.ColumnSpan="2" />
                        <CheckBox x:Name="SfxCheck" Grid.Row="1" Grid.Column="0" />
                        <CheckBox x:Name="HeaderEncCheck" Grid.Row="1" Grid.Column="1" IsChecked="True" />
                        <CheckBox x:Name="SolidCheck" Grid.Row="2" Grid.Column="0" />
                        <CheckBox x:Name="MtCheck" Grid.Row="2" Grid.Column="1" IsChecked="True" />
                    </Grid>
                    <Expander x:Name="CreateSafetyExpander">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="IncludeMasksBox" AutomationProperties.AutomationId="ArchiveIncludeMasks" AcceptsReturn="True" MaxLength="4096" MinHeight="56" TextWrapping="Wrap" />
                            <TextBox x:Name="ExcludeMasksBox" AutomationProperties.AutomationId="ArchiveExcludeMasks" AcceptsReturn="True" MaxLength="4096" MinHeight="56" TextWrapping="Wrap" />
                            <CheckBox x:Name="PreserveNtfsTimesCheck" AutomationProperties.AutomationId="ArchivePreserveNtfsTimes" />
                            <CheckBox x:Name="MoveSourceCheck" AutomationProperties.AutomationId="ArchiveMoveSourceAfterTest" />
                            <TextBlock x:Name="MoveSafetyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="RarNote" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Quick ops -->
            <StackPanel x:Name="QuickOps" Orientation="Horizontal" Spacing="8" />

            <Expander x:Name="DeleteEntriesExpander">
                <Border Padding="16,14,16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="DeleteMasksBox" AutomationProperties.AutomationId="ArchiveDeleteMasks" AcceptsReturn="True" MaxLength="4096" MinHeight="56" TextWrapping="Wrap" />
                        <CheckBox x:Name="DeleteRecursiveCheck" AutomationProperties.AutomationId="ArchiveDeleteRecursive" />
                        <Button x:Name="DeleteEntriesBtn" AutomationProperties.AutomationId="ArchiveDeleteEntries" HorizontalAlignment="Stretch" Click="DeleteEntries_Click" />
                        <TextBlock x:Name="DeleteSafetyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Output -->
            <Border x:Name="OutBorder" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Visibility="Collapsed">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OutText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Advanced operations -->
            <TextBlock x:Name="AdvancedHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <AutoSuggestBox x:Name="OpsFilter" MaxWidth="420" HorizontalAlignment="Left" QueryIcon="Find" TextChanged="OpsFilter_TextChanged" />

            <!-- One persistent result bar for advanced operations (not per-row) -->
            <InfoBar x:Name="OpsResultBar" IsClosable="True" IsOpen="False" />

            <!-- Advanced-operation output -->
            <Border x:Name="OpsOutBorder" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Visibility="Collapsed">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OpsOutText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Control-based operation rows (no TweakCard) with a subtle Fluent entrance animation -->
            <StackPanel x:Name="OpsPanel">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
