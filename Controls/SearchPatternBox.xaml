<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinForge.Controls.SearchPatternBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Control_Loaded"
    Unloaded="Control_Unloaded"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="QueryBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="SearchPatternQuery"
                QueryIcon="Find"
                TextChanged="QueryBox_TextChanged" />

            <ToggleButton
                x:Name="RegexModeButton"
                Grid.Column="1"
                MinWidth="44"
                Padding="8,4"
                Click="RegexModeButton_Click">
                <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text=".*" />
            </ToggleButton>

            <Button
                x:Name="BuilderButton"
                Grid.Column="2"
                MinWidth="44"
                Padding="8,4">
                <FontIcon FontSize="15" Glyph="&#xE70F;" />
                <Button.Flyout>
                    <Flyout x:Name="BuilderFlyout" Opening="BuilderFlyout_Opening">
                        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BuilderPanel" Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="BuilderTitle"
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="EngineText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBox
                                    x:Name="RawPatternBox"
                                    AutomationProperties.AutomationId="SearchPatternRawPattern"
                                    FontFamily="Consolas"
                                    MaxLength="4096"
                                    TextChanged="RawPatternBox_TextChanged" />

                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="IgnoreCaseCheck" Click="Flag_Click" />
                                    <CheckBox x:Name="MultilineCheck" Click="Flag_Click" />
                                    <CheckBox x:Name="SinglelineCheck" Click="Flag_Click" />
                                    <CheckBox x:Name="IgnoreWhitespaceCheck" Click="Flag_Click" />
                                    <CheckBox x:Name="ExplicitCaptureCheck" Click="Flag_Click" />
                                </StackPanel>

                                <InfoBar
                                    x:Name="SyntaxBar"
                                    AutomationProperties.LiveSetting="Polite"
                                    IsClosable="False" />

                                <Expander x:Name="GuidedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Padding="0,8,0,0" Spacing="8">
                                        <ComboBox x:Name="PieceKindBox" HorizontalAlignment="Stretch" SelectionChanged="PieceKindBox_SelectionChanged" />
                                        <ComboBox x:Name="AnchorBox" HorizontalAlignment="Stretch" />
                                        <TextBox x:Name="PiecePrimaryBox" FontFamily="Consolas" MaxLength="4096" />
                                        <TextBox x:Name="PieceSecondaryBox" FontFamily="Consolas" MaxLength="4096" />
                                        <CheckBox x:Name="PieceOptionCheck" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AddPieceButton" Grid.Column="0" HorizontalAlignment="Stretch" Click="AddPiece_Click" />
                                            <Button x:Name="ClearPatternButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="ClearPattern_Click" />
                                        </Grid>
                                        <TextBlock x:Name="PieceStatusText" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>

                                <TextBox
                                    x:Name="SampleBox"
                                    AcceptsReturn="True"
                                    AutomationProperties.AutomationId="SearchPatternSample"
                                    FontFamily="Consolas"
                                    MaxLength="1000000"
                                    MinHeight="96"
                                    TextChanged="SampleBox_TextChanged"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="PreviewText"
                                    AutomationProperties.LiveSetting="Polite"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    MaxHeight="180"
                                    TextWrapping="Wrap" />

                                <Button x:Name="CopyPatternButton" HorizontalAlignment="Left" Click="CopyPattern_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock x:Name="CopyPatternLabel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <TextBlock
            x:Name="ValidationText"
            AutomationProperties.LiveSetting="Polite"
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
