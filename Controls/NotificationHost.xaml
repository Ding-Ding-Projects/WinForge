<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinForge.Controls.NotificationHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        Width="400"
        MaxWidth="400"
        Spacing="8">
        <StackPanel
            x:Name="ToastStack"
            Spacing="8"
            automation:AutomationProperties.Name="Active notifications · 使用中通知" />
        <Button
            x:Name="HistoryButton"
            MinWidth="48"
            MinHeight="44"
            Padding="12,8"
            HorizontalAlignment="Right"
            ToolTipService.ToolTip="Notification centre · 通知中心"
            automation:AutomationProperties.AutomationId="ShellNotificationCentreButton"
            automation:AutomationProperties.Name="Open notification centre · 開啟通知中心">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                <TextBlock
                    x:Name="UnreadText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="0" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
